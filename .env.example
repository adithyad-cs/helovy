# HIVE DOCS (PS5) — local configuration template (docs/05 §9).
#
# Copy to `.env` (git-ignored) and replace every <placeholder>. Never commit `.env`.
# Use long random values made of URL-safe characters only (letters, digits, - and _),
# because the database passwords are also embedded in the connection URLs below.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"   # passwords and S3 keys
#   python3 -c "import secrets; print(secrets.token_hex(32))"       # CSRF_SECRET
#
# Host names: the URLs below point at `localhost`, for tools run on the host
# (uvicorn --reload, alembic, the CLI). docker-compose.yml overrides DATABASE_URL,
# MIGRATION_DATABASE_URL and S3_ENDPOINT_URL for the `app` container, where the
# hosts are `db` and `storage` (built from the passwords below).

# development | demo | production. `demo` and `production` disable the API docs UI.
APP_ENV=development
# Exact origin used for CSRF and Origin checks (http://localhost:5173 while using the Vite dev server).
APP_ORIGIN=http://localhost:8000

# Restricted runtime role (docs/06 §11). Password must equal PS5_APP_PASSWORD.
DATABASE_URL=postgresql+psycopg://ps5_app:<ps5_app password>@localhost:5432/ps5
# Owner role for Alembic and the CLI. Password must equal PS5_MIGRATOR_PASSWORD.
MIGRATION_DATABASE_URL=postgresql+psycopg://ps5_migrator:<ps5_migrator password>@localhost:5432/ps5

# Local SeaweedFS S3 endpoint (docs/05 §7.2). The key pair must match the
# "ps5-dev" identity in deploy/seaweedfs/s3.json.
S3_ENDPOINT_URL=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=ps5-documents-dev
S3_ACCESS_KEY_ID=<dev access key>
S3_SECRET_ACCESS_KEY=<dev secret key>
# path (SeaweedFS) | virtual (DigitalOcean Spaces)
S3_ADDRESSING_STYLE=path

# 64 hex characters (32 random bytes). Keys the CSRF token and the login-failure subject hash.
CSRF_SECRET=<64 hex characters>

RENDER_WORKERS=2
RENDER_TIMEOUT_S=20
# Leave unset locally: the socket address is used as the client IP (docs/12 §2.2).
# CLIENT_IP_HEADER=
LOG_LEVEL=INFO

# DEMO_ACCOUNT_PASSWORD is never stored here: set it only for the one CLI call (docs/05 §6.2).

# --- Local Docker Compose only: read by deploy/postgres/init on first start of the pgdata volume ---
POSTGRES_PASSWORD=<postgres superuser password>
PS5_MIGRATOR_PASSWORD=<ps5_migrator password>
PS5_APP_PASSWORD=<ps5_app password>

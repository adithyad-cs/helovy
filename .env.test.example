# HIVE DOCS (PS5) — test configuration template (docs/05 §12).
#
# Copy to `.env.test` (git-ignored). Same variable names as `.env`, pointing at the
# `ps5_test` database and the `ps5-documents-test` bucket. Test runs never touch `ps5`.
# The test suite refuses to start unless DATABASE_URL ends in /ps5_test and S3_BUCKET
# is the test bucket.
#
# The database passwords are the same roles as in `.env` (one PostgreSQL server hosts
# both databases). The S3 key pair is a separate identity ("ps5-test" in
# deploy/seaweedfs/s3.json) limited to the test bucket (docs/12 §8).

APP_ENV=development
APP_ORIGIN=http://localhost:8000

DATABASE_URL=postgresql+psycopg://ps5_app:<ps5_app password>@localhost:5432/ps5_test
MIGRATION_DATABASE_URL=postgresql+psycopg://ps5_migrator:<ps5_migrator password>@localhost:5432/ps5_test

S3_ENDPOINT_URL=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=ps5-documents-test
S3_ACCESS_KEY_ID=<test access key>
S3_SECRET_ACCESS_KEY=<test secret key>
S3_ADDRESSING_STYLE=path

# Use a different value from `.env`.
CSRF_SECRET=<64 hex characters>

RENDER_WORKERS=2
RENDER_TIMEOUT_S=20
LOG_LEVEL=INFO
